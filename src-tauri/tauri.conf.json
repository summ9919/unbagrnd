{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unbagrnd 抠图",
  "mainBinaryName": "unbagrnd",
  "version": "0.4.0",
  "identifier": "com.unbagrnd.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "unbagrnd — AI 抠图工具",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "category": "Utility",
    "shortDescription": "在本机完成图片背景移除。",
    "longDescription": "unbagrnd 完全在本机移除图片背景。无需云端 API、无需账号、无遥测，完成一次性模型下载后即可离线使用。"
  }
}
